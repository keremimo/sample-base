# The USB webcam function (configfs "uvc"), for Screen Mirror
# (src/drivers/screen_mirror.h). The MPC's kernel is built without it. These
# are drivers/usb/gadget/function/{f_uvc,uvc_*}.c and
# drivers/media/common/uvc.c (as uvc_common.c) from inMusic's public 6.12.60
# release. Their changes are marked "sample-base:" in f_uvc.c: the function
# never holds the gadget off the bus while no process has the video device
# open, and refuses the computer's requests until one does.
obj-m := sample_base_uvc.o
sample_base_uvc-y := f_uvc.o uvc_configfs.o uvc_queue.o uvc_v4l2.o uvc_video.o uvc_common.o
